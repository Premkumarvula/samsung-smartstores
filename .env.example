# Copy this file to `.env` for local development.
# In production these are set as real environment variables on the EC2
# instance (e.g. via systemd EnvironmentFile) — never committed to git.

FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Defaults to a local SQLite file under instance/ if unset.
DATABASE_URL=sqlite:///instance/store.db

LOG_LEVEL=INFO
LOG_DIR=logs
